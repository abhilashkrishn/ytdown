# StreamVault Environment Configuration Example
# Copy this file to .env and replace placeholders with secure values.

AUTH_USERNAME=admin
AUTH_PASSWORD=change_this_to_a_secure_password
SESSION_SECRET=replace_with_at_least_32_random_characters_long_secret
CANONICAL_ORIGIN=http://127.0.0.1:8300
ALLOWED_ORIGINS=http://127.0.0.1:8300
TRUST_REVERSE_PROXY=false
TRUSTED_PROXIES=127.0.0.1,::1
COOKIE_SECURE=false
USE_X_ACCEL_REDIRECT=false
